{
	"name": "df_repartidores",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Origen_Repartidores",
						"type": "DatasetReference"
					},
					"name": "origenRepartidores"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Destino_Repartidores",
						"type": "DatasetReference"
					},
					"name": "destinoRepartidoresSQL"
				}
			],
			"transformations": [
				{
					"name": "normalizarRepartidores"
				},
				{
					"name": "validarRepartidores"
				},
				{
					"name": "seleccionarSalidaRepartidores"
				}
			],
			"scriptLines": [
				"source(output(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as string,",
				"          activo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> origenRepartidores",
				"origenRepartidores derive(repartidor_id = upper(trim(repartidor_id)),",
				"          nombre_repartidor = initCap(lower(trim(nombre_repartidor)))\r",
				",",
				"          tipo_vehiculo = initCap(lower(trim(tipo_vehiculo))),",
				"          ciudad_base = initCap(lower(trim(ciudad_base))),",
				"          fecha_alta = iif(\r",
				"    isDate(fecha_alta,'yyyy-MM-dd'),\r",
				"    toDate(fecha_alta,'yyyy-MM-dd'),\r",
				"    toDate(fecha_alta,'dd/MM/yyyy')\r",
				"),",
				"          activo = initCap(lower(trim(activo)))) ~> normalizarRepartidores",
				"normalizarRepartidores split(regexMatch(repartidor_id,'^REP[0-9]{4}$') &&\r",
				"length(trim(nombre_repartidor)) > 0 &&\r",
				"(\r",
				"    lower(trim(tipo_vehiculo)) == 'moto' ||\r",
				"    lower(trim(tipo_vehiculo)) == 'auto' ||\r",
				"    lower(trim(tipo_vehiculo)) == 'bicicleta'\r",
				") &&\r",
				"length(trim(ciudad_base)) > 0 &&\r",
				"!isNull(fecha_alta) &&\r",
				"(\r",
				"    lower(trim(activo)) == 'sí' ||\r",
				"    lower(trim(activo)) == 'si' ||\r",
				"    lower(trim(activo)) == 'no'\r",
				"),",
				"     disjoint: false) ~> validarRepartidores@(validos, invalidos)",
				"validarRepartidores@validos select(mapColumn(",
				"          repartidor_id,",
				"          nombre_repartidor,",
				"          tipo_vehiculo,",
				"          ciudad_base,",
				"          fecha_alta,",
				"          activo",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarSalidaRepartidores",
				"seleccionarSalidaRepartidores sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          repartidor_id as string,",
				"          nombre_repartidor as string,",
				"          tipo_vehiculo as string,",
				"          ciudad_base as string,",
				"          fecha_alta as date,",
				"          activo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> destinoRepartidoresSQL"
			]
		}
	}
}