{
	"name": "df_promociones",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Origen_Promociones",
						"type": "DatasetReference"
					},
					"name": "origenPromociones"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Destino_Promociones",
						"type": "DatasetReference"
					},
					"name": "destinoPromocionesSQL"
				}
			],
			"transformations": [
				{
					"name": "normalizarPromociones"
				},
				{
					"name": "validarPromociones"
				},
				{
					"name": "seleccionarSalidaPromociones"
				}
			],
			"scriptLines": [
				"source(output(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as string,",
				"          fecha_fin as string,",
				"          porcentaje_descuento as string,",
				"          canal_aplicable as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> origenPromociones",
				"origenPromociones derive(promocion_id = upper(trim(promocion_id)),",
				"          nombre_promocion = initCap(lower(trim(nombre_promocion))),",
				"          fecha_inicio = toDate(trim(fecha_inicio),'yyyy-MM-dd'),",
				"          fecha_fin = toDate(trim(fecha_fin),'yyyy-MM-dd'),",
				"          porcentaje_descuento = toDecimal(trim(porcentaje_descuento),5,2),",
				"          canal_aplicable = initCap(lower(trim(canal_aplicable)))) ~> normalizarPromociones",
				"normalizarPromociones split(regexMatch(promocion_id,'^PROM[0-9]{3}$') &&\r",
				"length(trim(nombre_promocion)) > 0 &&\r",
				"!isNull(fecha_inicio) &&\r",
				"!isNull(fecha_fin) &&\r",
				"fecha_fin >= fecha_inicio &&\r",
				"porcentaje_descuento > 0 &&\r",
				"porcentaje_descuento <= 100 &&\r",
				"length(trim(canal_aplicable)) > 0,",
				"     disjoint: false) ~> validarPromociones@(validos, invalidos)",
				"validarPromociones@validos select(mapColumn(",
				"          promocion_id,",
				"          nombre_promocion,",
				"          fecha_inicio,",
				"          fecha_fin,",
				"          porcentaje_descuento,",
				"          canal_aplicable",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarSalidaPromociones",
				"seleccionarSalidaPromociones sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          promocion_id as string,",
				"          nombre_promocion as string,",
				"          fecha_inicio as date,",
				"          fecha_fin as date,",
				"          porcentaje_descuento as integer,",
				"          canal_aplicable as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> destinoPromocionesSQL"
			]
		}
	}
}