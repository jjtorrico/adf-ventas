{
	"name": "df_detalle_pedidos",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Origen_Detalle_Pedidos",
						"type": "DatasetReference"
					},
					"name": "origenDetalle"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Destino_Detalle_Pedidos",
						"type": "DatasetReference"
					},
					"name": "destinoDetalleSQL"
				}
			],
			"transformations": [
				{
					"name": "normalizarDetalle"
				},
				{
					"name": "validarDetalle"
				},
				{
					"name": "recalcularTotal"
				},
				{
					"name": "seleccionarSalidaDetalle"
				}
			],
			"scriptLines": [
				"source(output(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as string,",
				"          precio_unitario as string,",
				"          descuento_linea as string,",
				"          total_linea as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> origenDetalle",
				"origenDetalle derive(detalle_id = upper(trim(detalle_id)),",
				"          pedido_id = upper(trim(pedido_id)),",
				"          producto_id = upper(trim(producto_id)),",
				"          cantidad = toInteger(trim(cantidad)),",
				"          precio_unitario = toDecimal(replace(trim(precio_unitario), ',', '.'), 10, 2),",
				"          descuento_linea = toDecimal(replace(trim(descuento_linea), ',', '.'), 10, 2),",
				"          total_linea = toDecimal(replace(trim(total_linea), ',', '.'), 10, 2)) ~> normalizarDetalle",
				"normalizarDetalle split(regexMatch(detalle_id, '^DET[0-9]{7}$') &&\r",
				"regexMatch(pedido_id, '^PED[0-9]{6}$') &&\r",
				"regexMatch(producto_id, '^PRO[0-9]{4}$') &&\r",
				"cantidad > 0 &&\r",
				"precio_unitario > 0 &&\r",
				"descuento_linea >= 0,",
				"     disjoint: false) ~> validarDetalle@(validos, invalidos)",
				"validarDetalle@validos derive(total_linea = round((cantidad * precio_unitario) - descuento_linea, 2)) ~> recalcularTotal",
				"recalcularTotal select(mapColumn(",
				"          detalle_id,",
				"          pedido_id,",
				"          producto_id,",
				"          cantidad,",
				"          precio_unitario,",
				"          descuento_linea,",
				"          total_linea",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> seleccionarSalidaDetalle",
				"seleccionarSalidaDetalle sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          detalle_id as string,",
				"          pedido_id as string,",
				"          producto_id as string,",
				"          cantidad as integer,",
				"          precio_unitario as decimal(10,2),",
				"          descuento_linea as decimal(10,2),",
				"          total_linea as decimal(10,2)",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> destinoDetalleSQL"
			]
		}
	}
}